# Single-tenant credentials (stdio, and HTTP only when AUTH_MODE=env).
# The gateway-mode compose service does not load these. Do not add them to
# that service's environment or via env_file. Gateway mode requires the
# X-RocketCyber-API-Key header on each request (X-RocketCyber-Region optional).
ROCKETCYBER_API_KEY=
ROCKETCYBER_REGION=us

# stdio (default) or http
MCP_TRANSPORT=stdio

# Bind address when a real CONDUIT_S2S_SECRET is set. Unset keeps 0.0.0.0,
# the historical container bind. The image and Compose set 0.0.0.0 inside
# the container and publish the host port on 127.0.0.1.
# MCP_ALLOW_INSECURE_DEV=1 ignores this and binds 127.0.0.1 only.
# MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8080

# Required to start the HTTP transport. The process logs an error and exits
# non-zero when this is empty or a known placeholder (changeme, secret,
# replace-me, your-s2s-secret, and the other example values). Generate with:
#   openssl rand -hex 32
# Never commit a real secret. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without
# CONDUIT_S2S_SECRET. The server logs a warning, does not check X-Gateway-S2S,
# and binds 127.0.0.1 only. A non-loopback MCP_HTTP_HOST is overridden.
# A known placeholder secret still refuses to start when this is set.
# MCP_ALLOW_INSECURE_DEV=1

# Credential source for HTTP: env (process environment) or gateway (required
# X-RocketCyber-API-Key header; no env fallback). The container image and
# Compose service set gateway. Stdio ignores this and reads ROCKETCYBER_*
# from the environment.
# AUTH_MODE=gateway

LOG_LEVEL=info
